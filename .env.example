# Name des Docker-Netzwerks, in dem dein Nginx Proxy Manager läuft.
# Herausfinden: docker inspect <npm-container-name> --format '{{json .NetworkSettings.Networks}}'
NPM_NETWORK=nginx-proxy-manager_default

# Deine Tools-Domain. Tools mit "Eigene Subdomain" laufen dann unter <pfad>.TOOLS_DOMAIN,
# z. B. npm.tools.example.de. Leer lassen, wenn du keine Subdomains nutzt.
TOOLS_DOMAIN=tools.example.de

# Authentik-Gruppe, die die Admin-Seite (/admin/) nutzen darf und alle Tools sieht
ADMIN_GROUP=tools-admin

# Nutzer-ID, unter der das Backend läuft (muss in ./data und ./sites schreiben dürfen): id -u / id -g
TOOLS_UID=1000
TOOLS_GID=1000

# Geheimes Passwort zwischen Nginx Proxy Manager und tools-web (verhindert gefälschte Login-Header).
# Erzeugen mit:  openssl rand -hex 32
# Derselbe Wert kommt auch in npm/location-root.conf (NPM, Custom location).
TOOLS_SECRET=

# Zeitzone (für Zeitfenster von Freigabe-Links und Anzeigen)
TZ=Europe/Berlin

# --- Überwachung der Weiterleitungs-Tools (Container tools-monitor) ---
# Prüfintervall in Sekunden und wie viele Fehlversuche in Folge als Ausfall gelten
HEALTH_INTERVAL=60
HEALTH_FAILS=2
# Benachrichtigungen bei Ausfall/Wiederherstellung - alles optional, mehrere gleichzeitig möglich:
# ntfy (App für Handy-Benachrichtigungen): z. B. https://ntfy.sh/mein-geheimes-thema oder dein eigener ntfy-Server
NOTIFY_NTFY_URL=
NOTIFY_NTFY_TOKEN=
# Telegram: Bot bei @BotFather anlegen -> Token; Chat-ID z. B. über @userinfobot
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=
# Beliebiger Webhook (bekommt JSON {"title","message","text"}), z. B. Home Assistant, Discord, Gotify-Proxy
NOTIFY_WEBHOOK_URL=
